# Frontend. Copy the VITE_ lines into frontend/.env.local.
# Create the database by running supabase/schema.sql in the Supabase SQL editor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# Backend. Never expose the service role key or model keys in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
